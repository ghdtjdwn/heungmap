# 이 파일을 복사해서 `.env` 로 만들고 실제 키를 채우세요. (.env 는 절대 커밋 금지)
# cp .env.example .env

# --- 로그인·역할·공개 행사 (현재는 개발용 모의 로그인) ---
HEUNGMAP_ENV=development
HEUNGMAP_AUTH_MODE=mock
HEUNGMAP_PUBLIC_ORIGIN=http://localhost:3000
# 기본 DB는 프로젝트 data/heungmap.sqlite3. 실제 계정·세션·분석이므로 Git에 넣지 않습니다.
# HEUNGMAP_DB_PATH=/absolute/path/heungmap.sqlite3
# 배포 때 HEUNGMAP_ENV=production, HEUNGMAP_AUTH_MODE=google, HTTPS origin으로 전환합니다.
# Google Console에 {HEUNGMAP_PUBLIC_ORIGIN}/api/v1/auth/google/callback 을 등록합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# frontend 프로세스 환경변수. 기본 backend 주소는 http://127.0.0.1:8000 입니다.
# HEUNGMAP_BACKEND_URL=http://127.0.0.1:8000

# --- 한국관광공사 / 공공데이터포털 (필수) ---
# 발급: https://data.go.kr  →  "한국관광공사 국문 관광정보 서비스" 활용신청
TOURAPI_SERVICE_KEY=

# 발급: https://data.go.kr  →  "한국관광공사 지역별 방문자수" 활용신청 (예측 라벨용)
VISITOR_API_SERVICE_KEY=

# --- 지도 (주차/숙소/위치 표시용) ---
# 발급: https://developers.kakao.com
# 브라우저에 포함되는 공개 JavaScript 키입니다. localhost:3000을 JavaScript SDK 도메인에 등록하세요.
KAKAO_JAVASCRIPT_KEY=

# 같은 Kakao Developers 앱의 REST API 키. 주소 검색과 주변 주차장·숙박시설 보강에 사용
KAKAO_REST_API_KEY=

# --- 날씨 (선택 feature) ---
# 발급: https://data.go.kr  →  기상청 단기예보/과거관측
WEATHER_API_SERVICE_KEY=

# --- LLM (기획 보고서 생성, 미설정·실패 시 규칙 fallback) ---
# 기본값은 Ollama 로컬 실행입니다. `ollama pull qwen3.5:9b` 후 사용합니다.
LLM_PROVIDER=ollama
LLM_API_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_SECONDS=180
# OpenAI Responses API로 바꿀 때만 provider=openai, base URL, key와 model을 설정합니다.
LLM_API_KEY=
